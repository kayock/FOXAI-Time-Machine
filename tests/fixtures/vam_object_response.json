{"meta":{"version":"2.1","_links":{"self":{"href":"https://api.vam.ac.uk/v2/object/O73124"},"collection_page":{"href":"https://collections.vam.ac.uk/item/O73124/"}},"images":{"_primary_thumbnail":"https://framemark.vam.ac.uk/collections/2024NX3083/full/!100,100/0/default.jpg","_iiif_image":"https://framemark.vam.ac.uk/collections/2024NX3083/","_alt_iiif_image":[],"imageResolution":"high","_images_meta":[{"assetRef":"2024NX3083","copyright":"© Victoria and Albert Museum, London","sensitiveImage":false},{"assetRef":"2013GG4489","copyright":"© Victoria and Albert Museum, London","sensitiveImage":false},{"assetRef":"2006AG2385","copyright":"© Victoria and Albert Museum, London","sensitiveImage":false},{"assetRef":"2006AP4309","copyright":"© Victoria and Albert Museum, London","sensitiveImage":false},{"assetRef":"2017JX2781","copyright":"©Victoria and Albert Museum, London","sensitiveImage":false},{"assetRef":"2011EN5638","copyright":"© Victoria and Albert Museum, London","sensitiveImage":false}]},"see_also":{"_iiif_pres":"https://iiif.vam.ac.uk/collections/O73124/manifest.json","_alt_iiif_pres":[]}},"record":{"systemNumber":"O73124","accessionNumber":"E.4823-1916","objectType":"Woodblock print","titles":[{"title":"Thirty-Six Views of Mount Fuji","type":"series title"},{"title":"Under the Wave off Kanagawa","type":"assigned by artist"},{"title":"Great Wave","type":"popular title"}],"summaryDescription":"Katsushika Hokusai (1760-1849) is perhaps Japan's most famous artist. He is best known for his designs for prints and printed books, although later in life he focussed increasingly on paintings. \r\n\r\nThis print is from Hokusai's ground-breaking series <i>Thirty-six Views of Mount Fuji</i>, the first to exist exclusively of large-format prints of landscapes. It also made plentiful use of Prussian blue, a pigment which had only recently been introduced to Japan and was both expensive and rare.\r\n\r\nThis print is the most celebrated of the series, and indeed of all Japanese prints. In it, Mount Fuji is pictured through the hollow of a giant wave which threatens to engulf the boats below. The chaos of the scene at sea contrasts with the stately serenity of Fuji in the background.","physicalDescription":"Woodblock print. Horizontal ōban format, aizuri-e (blue-printed picture). Large wave over boats, Mount Fuji in distance.\r\n","artistMakerPerson":[{"name":{"text":"Katsushika Hokusai","id":"A6847"},"association":{"text":"Artist","id":"AAT25103"},"note":"Signed: 'Hokusai aratame Iitsu hitsu'"}],"artistMakerOrganisations":[],"artistMakerPeople":[],"materials":[{"text":"Paper","id":"x30308"}],"techniques":[{"text":"Woodblock print","id":"x38448"}],"materialsAndTechniques":"Woodblock print on paper","categories":[{"text":"Images Online","id":"THES48937"},{"text":"Prints","id":"THES48903"}],"styles":[{"text":"Ukiyo-e","id":"AAT106769"},{"text":"Edo","id":"AAT106658"}],"collectionCode":{"text":"EAS","id":"THES48596"},"images":["2024NX3083","2013GG4489","2006AG2385","2006AP4309","2017JX2781","2011EN5638"],"imageResolution":"high","galleryLocations":[{"current":{"text":"SHLN","id":"THES49063"},"free":"","case":"","shelf":"","box":""}],"partTypes":[[{"text":"Woodblock print","id":""}]],"contentWarnings":[{"apprise":"","note":""}],"placesOfOrigin":[{"place":{"text":"Japan","id":"x29399"},"association":{"text":"made","id":"x28654"},"note":""},{"place":{"text":"Edo","id":"x32430"},"association":{"text":"made","id":"x28654"},"note":""}],"productionDates":[{"date":{"text":"ca. 1831","earliest":"1826-01-01","latest":"1835-12-31"},"association":{"text":"made","id":"x28654"},"note":"As dated by Nagata Seiji in 'Masterpieces of Ukiyo-e from the Victoria and Albert Museum', Ota Memorial Museum, 2007"}],"associatedObjects":[{"object":{"text":"E.210-1915","id":"O407314"},"association":""}],"creditLine":"Gift of the Misses Alexander","dimensions":[{"dimension":"Height","value":"24.8","unit":"cm","qualifier":"","date":{"text":"","earliest":null,"latest":n